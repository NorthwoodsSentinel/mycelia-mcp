{
  // The one typecheck project. `include` is the whole tree, so a new
  // TypeScript file anywhere (source, test or config) is typechecked with no
  // edit here; the lint config names this project as its parser project, so a
  // `.ts` file outside it also fails lint. The compiler options are the
  // repo's own, unchanged.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "noImplicitAny": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["bun"]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
  "exclude": ["node_modules", "dist", "build", "coverage", ".scratch"]
}
